{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch ./src/local.ts",
    "build": "pnpm run typecheck:local",
    "start": "pnpm run start:local",
    "start:local": "tsx ./src/local.ts",
    "schema:development": "STORYHOLD_APPLY_DEVELOPMENT_SCHEMA=1 STORYHOLD_DATABASE_ENVIRONMENT=development tsx ./src/local.ts",
    "test": "node ./test.mjs",
    "typecheck:local": "tsc -p tsconfig.local.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-pgvector": "^0.0.5",
    "@google-cloud/storage": "^7.16.0",
    "@huggingface/transformers": "^4.2.0",
    "@mozilla/readability": "^0.6.0",
    "@workspace/content-utils": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "mammoth": "^1.12.0",
    "pg": "^8.20.0",
    "pino": "^9",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "esbuild": "^0.27.3",
    "pino-pretty": "^13",
    "tsx": "catalog:"
  }
}
