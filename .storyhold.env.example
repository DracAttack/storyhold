# Copy this file to .storyhold.env and add only the connections you want.
# The real .storyhold.env is ignored by Git and must never be committed.

# Provider routing. "auto" tries configured connections in Storyhold's safe
# default order. You can instead name: openai, anthropic, xai, kimi, or
# openrouter. OpenRouter is never added to the automatic fallback chain merely
# because a key exists; select it explicitly for a stage or provider lane.
STORYHOLD_AI_PROVIDER=auto
STORYHOLD_EXTRACTION_PROVIDER=auto
# Hosted deployments use one managed premium phase after local intake. With no
# OpenRouter key below this lane remains unavailable and makes no remote call;
# it does not fall through to another provider.
STORYHOLD_VERIFICATION_PROVIDER=openrouter
STORYHOLD_DOSSIER_PROVIDER=auto
STORYHOLD_CHRONOLOGY_PROVIDER=auto
STORYHOLD_DIRECTOR_PROVIDER=auto
STORYHOLD_NARRATOR_PROVIDER=auto
STORYHOLD_ADAPTATION_PROVIDER=auto
STORYHOLD_ANALYSIS_PROVIDER=auto
STORYHOLD_CANON_PROVIDER=auto

# Explicit adult scenes have an isolated lane and never use the normal fallback
# chain. Name an eligible provider deliberately (for example, xai) after
# confirming that connection is approved for the intended content.
STORYHOLD_ADULT_PROVIDER=

# OpenAI
STORYHOLD_OPENAI_API_KEY=
STORYHOLD_OPENAI_MODEL=gpt-5.6-luna

# Anthropic
STORYHOLD_ANTHROPIC_API_KEY=
STORYHOLD_ANTHROPIC_MODEL=claude-haiku-4-5

# xAI / Grok
STORYHOLD_XAI_API_KEY=
STORYHOLD_XAI_MODEL=grok-4.5

# Moonshot / Kimi
STORYHOLD_KIMI_API_KEY=
STORYHOLD_KIMI_MODEL=kimi-k3

# OpenRouter. Storyhold always uses OpenRouter's fixed public chat-completions
# endpoint and sends Storyhold attribution headers; arbitrary proxy endpoints
# are intentionally unsupported. Every request requires zero-data-retention,
# denies provider data collection, and only considers endpoints that support all
# requested parameters. Auto/latest aliases and route modifiers fail closed.
# Only this Storyhold-specific key activates managed billing; a generic shell
# OPENROUTER_API_KEY is deliberately ignored.
STORYHOLD_OPENROUTER_API_KEY=
STORYHOLD_OPENROUTER_EXTRACTION_MODEL=mistralai/mistral-small-2603
# Premium verification is pinned in code to openai/gpt-5.6-luna-pro so changing
# it requires an audited deployment rather than an environment-only model swap.
STORYHOLD_OPENROUTER_DOSSIER_MODEL=anthropic/claude-sonnet-4.6
STORYHOLD_OPENROUTER_CHRONOLOGY_MODEL=qwen/qwen3.5-397b-a17b-20260216
STORYHOLD_OPENROUTER_DIRECTOR_MODEL=qwen/qwen3.5-397b-a17b-20260216
STORYHOLD_OPENROUTER_NARRATION_MODEL=anthropic/claude-sonnet-4.6
STORYHOLD_OPENROUTER_ADAPTATION_MODEL=anthropic/claude-sonnet-4.6

# OpenRouter's adult lane remains fail-closed. It requires all three values:
# explicit adult provider selection above, this approval flag, and a named model.
STORYHOLD_OPENROUTER_ADULT_ENABLED=false
STORYHOLD_OPENROUTER_ADULT_MODEL=

# Required sequential local Canon Intake. The one-time installer downloads all
# six specialist models. Normal operation is loopback-only and offline. Exactly one
# model is resident at a time: GLiNER2, coreference, NLI, MiniLM, BGE,
# or Qwen.
STORYHOLD_REQUIRE_FULL_LOCAL_INTAKE=true
STORYHOLD_LOCAL_ACCELERATION=auto
# On a CUDA-capable computer these PyTorch stages try the GPU one at a time.
# Auto mode falls back to CPU if a particular model cannot fit in VRAM.
STORYHOLD_LOCAL_CUDA_STAGES=gliner2,coreference,nli,minilm,bge
STORYHOLD_LOCAL_GLINER2_ENABLED=true
STORYHOLD_LOCAL_GLINER2_URL=http://127.0.0.1:8765/gliner2
STORYHOLD_LOCAL_GLINER2_MODEL=fastino/gliner2-base-v1
STORYHOLD_LOCAL_NER_ENABLED=true
STORYHOLD_LOCAL_NER_URL=http://127.0.0.1:8765/gliner2
STORYHOLD_LOCAL_NER_MODEL=fastino/gliner2-base-v1
STORYHOLD_LOCAL_NER_THRESHOLD=0.42
STORYHOLD_LOCAL_NER_CONCURRENCY=3
STORYHOLD_LOCAL_NER_TIMEOUT_MS=45000
STORYHOLD_LOCAL_NER_ALLOW_REMOTE=false
STORYHOLD_LOCAL_MINILM_ENABLED=true
STORYHOLD_LOCAL_MINILM_URL=http://127.0.0.1:8765/rerank/fast
STORYHOLD_LOCAL_MINILM_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
STORYHOLD_LOCAL_RERANKER_ENABLED=true
STORYHOLD_LOCAL_RERANKER_URL=http://127.0.0.1:8765/rerank/final
STORYHOLD_LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
STORYHOLD_LOCAL_BGE_MODEL=BAAI/bge-reranker-v2-m3
STORYHOLD_LOCAL_NLI_ENABLED=true
STORYHOLD_LOCAL_NLI_URL=http://127.0.0.1:8765/nli
STORYHOLD_LOCAL_NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
STORYHOLD_LOCAL_COREFERENCE_ENABLED=true
STORYHOLD_LOCAL_COREFERENCE_URL=http://127.0.0.1:8765/coreference
STORYHOLD_LOCAL_COREFERENCE_MODEL=biu-nlp/f-coref
STORYHOLD_LOCAL_QWEN_ENABLED=true
STORYHOLD_LOCAL_QWEN_URL=http://127.0.0.1:8765/qwen/audit
# The installer uses the local Q4_K_M GGUF build of this same model.
STORYHOLD_LOCAL_QWEN_MODEL=Qwen/Qwen3.5-4B-Instruct
# The local launcher defaults to the 32-layer setting benchmarked on this
# laptop. Set zero only when deliberately forcing the reader back to CPU.
STORYHOLD_LOCAL_QWEN_GPU_LAYERS=32
# Keep Qwen's logical prompt batch at 512 while llama.cpp computes it in
# smaller chunks. This preserves the model/context and lowers peak VRAM use.
STORYHOLD_LOCAL_QWEN_BATCH_SIZE=512
STORYHOLD_LOCAL_QWEN_MICRO_BATCH_SIZE=128
# Optional emergency headroom: false moves K/Q/V compute to CPU and is slower,
# but still uses the exact same model, evidence, context, and output settings.
STORYHOLD_LOCAL_QWEN_OFFLOAD_KQV=true
# This laptop exposes Intel as Vulkan device 0 and NVIDIA as device 1.
STORYHOLD_LOCAL_QWEN_VULKAN_DEVICE=1
STORYHOLD_LOCAL_MODELS_ALLOW_REMOTE=false

# Private credit policy. These values are operational only and are never sent
# to customer-facing APIs. The margin setting is clamped to at least 4000 bps.
STORYHOLD_RETAIL_MICROS_PER_CREDIT=20000
STORYHOLD_TARGET_GROSS_MARGIN_BPS=4000

# Internal Canon Intake meters. The customer sees only the combined Storyhold
# credit quote/charge, never this component accounting or provider margins.
STORYHOLD_LOCAL_INTAKE_BASE_CREDITS=100
STORYHOLD_LOCAL_INTAKE_CREDITS_PER_1K_WORDS=1
STORYHOLD_LOCAL_INTAKE_WARNING_WORDS=150000
STORYHOLD_LOCAL_INTAKE_MAX_WORLD_WORDS=250000
STORYHOLD_LOCAL_INTAKE_MAX_CREDITS=10000
STORYHOLD_BROWSER_QWEN_INPUT_CREDITS_PER_MILLION=300
STORYHOLD_BROWSER_QWEN_OUTPUT_CREDITS_PER_MILLION=1200
STORYHOLD_BROWSER_QWEN_MAX_CREDITS=10000

# Private turn-engine key. Use a long random value in any shared deployment.
# It freezes fair, retry-stable luck without exposing a predictable roll seed.
STORYHOLD_CAUSAL_SECRET=

# Custom/unlisted models fail closed for paid work unless all relevant rates
# are supplied. Replace PROVIDER with OPENAI, ANTHROPIC, XAI, KIMI, or
# OPENROUTER. A stage-specific override may insert the stage name before the
# rate, for example STORYHOLD_OPENROUTER_DOSSIER_INPUT_USD_PER_M.
# STORYHOLD_PROVIDER_INPUT_USD_PER_M=
# STORYHOLD_PROVIDER_CACHED_INPUT_USD_PER_M=
# STORYHOLD_PROVIDER_CACHE_WRITE_INPUT_USD_PER_M=
# STORYHOLD_PROVIDER_OUTPUT_USD_PER_M=

# Optional research/retrieval service inherited from BrainHook. Storyhold never
# lets web research silently enter a fictional world's canon.
PERPLEXITY_API_KEY=

# The Hold uses local MiniLM embeddings by default, so semantic retrieval adds
# no per-turn provider charge. Perplexity is optional and must return 384
# dimensions to share Storyhold's current vector store.
SOURCE_VAULT_EMBED_PROVIDER=local
# SOURCE_VAULT_LOCAL_EMBED_MODEL=Xenova/all-MiniLM-L6-v2

# Optional anonymous aggregate learning. Set this to a long random secret in
# production. The pipeline also requires each player to opt in; without both,
# no cross-game contribution is written.
STORYHOLD_PATTERN_SALT=
